{
  "name": "qa-technical-assessment",
  "version": "1.0.0",
  "private": true,
  "description": "Web (cheapflights.com.au) and API (restful-booker) test automation — Playwright + TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:web": "playwright test --project=web",
    "test:api": "playwright test --project=api",
    "test:mobile": "playwright test --project=web-mobile",
    "test:headed": "playwright test --project=web --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "api-testing"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  }
}
